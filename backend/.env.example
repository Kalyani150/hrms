# Copy this file to `.env` and fill in the real values. Never commit `.env`.

PORT=5000
NODE_ENV=development

# MongoDB connection string.
#   local development:  mongodb://127.0.0.1:27017/hrms   (start it with `npm run db`)
#   production (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hrms?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/hrms

# A long random string used to sign login tokens, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# The address the website is served from (used for CORS).
FRONTEND_URL=http://localhost:5173

# First admin account, created by `npm run seed`.
# The password needs 8+ characters with uppercase, lowercase, a number and a symbol.
ADMIN_NAME=HR Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Optional settings
# Check-ins after this time (India time, HH:MM) are marked Late
LATE_AFTER=09:30
# Annual leave allowance in days (shown as "Remaining" on the employee dashboard)
LEAVE_ALLOWANCE=20
# Number of reverse proxies in front of the API (1 on Vercel). Needed so the
# login rate limiter sees each visitor's real IP address in production.
TRUST_PROXY=1

# Email for "Forgot password" links (any SMTP provider, e.g. Gmail app password, Brevo, Mailtrap).
# Leave empty in development: the reset link is then shown on the page instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HRMS <no-reply@example.com>
